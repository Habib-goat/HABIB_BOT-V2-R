[
  {
    "id": 101,
    "name": "القارعة",
    "transliteration": "Al-Qari'ah",
    "translation": "মহাসংকট",
    "type": "meccan",
    "total_verses": 11,
    "verses": [
      {
        "id": 1,
        "text": "ٱلۡقَارِعَةُ",
        "pronunciation": "আল-ক্বারিাতু",
        "translation": "করাঘাতকারী"
      },
      {
        "id": 2,
        "text": "مَا ٱلۡقَارِعَةُ",
        "pronunciation": "মা আল-ক্বারিাতু",
        "translation": "করাঘাতকারী কি"
      },
      {
        "id": 3,
        "text": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ",
        "pronunciation": "ওয়া-মা আদরাকা মা আল-ক্বারিাতু",
        "translation": "করাঘাতকারী সম্পর্কে আপনি কি জানেন"
      },
      {
        "id": 4,
        "text": "يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ",
        "pronunciation": "ইয়াওমা ইয়াকূনু আন-নাসু কালফারাশি আল-মাবছূছি",
        "translation": "যেদিন মানুষ হবে বিক্ষিপ্ত পতংগের মত"
      },
      {
        "id": 5,
        "text": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ",
        "pronunciation": "ওয়া-তাকূনু আল-জিবালু কালািহনি আল-মানফূশি",
        "translation": "এবং পর্বতমালা হবে ধুনিত রঙ্গীন পশমের মত।"
      },
      {
        "id": 6,
        "text": "فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ",
        "pronunciation": "ফা-আম্মা মান ছাক্বুলাত মাওাযীনুহু",
        "translation": "অতএব যার পাল্লা ভারী হবে"
      },
      {
        "id": 7,
        "text": "فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ",
        "pronunciation": "ফা-হুয়া ফী আীশাতিন রাদিইয়াতিন",
        "translation": "সে সুখীজীবন যাপন করবে।"
      },
      {
        "id": 8,
        "text": "وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ",
        "pronunciation": "ওয়া-আম্মা মান খাফ্ফাত মাওাযীনুহু",
        "translation": "আর যার পাল্লা হালকা হবে"
      },
      {
        "id": 9,
        "text": "فَأُمُّهُۥ هَاوِيَةٞ",
        "pronunciation": "ফা-oম্মুহু হাওিইয়াতুন",
        "translation": "তার ঠিকানা হবে হাবিয়া।"
      },
      {
        "id": 10,
        "text": "وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ",
        "pronunciation": "ওয়া-মা আদরাকা মা হিইয়াহ",
        "translation": "আপনি জানেন তা কি"
      },
      {
        "id": 11,
        "text": "نَارٌ حَامِيَةُۢ",
        "pronunciation": "নারুন হামিইয়াতুন",
        "translation": "প্রজ্জ্বলিত অগ্নি"
      }
    ]
  },
  {
    "id": 102,
    "name": "التكاثر",
    "transliteration": "At-Takathur",
    "translation": "প্রাচুর্যের প্রতিযোগিতা",
    "type": "meccan",
    "total_verses": 8,
    "verses": [
      {
        "id": 1,
        "text": "أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ",
        "pronunciation": "আল-হাকুমু আত্ব-তাকাছুরু",
        "translation": "প্রাচুর্যের লালসা তোমাদেরকে গাফেল রাখে"
      },
      {
        "id": 2,
        "text": "حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ",
        "pronunciation": "হাত্তা যুরতুমু আল-মাক্বাবিরা",
        "translation": "এমনকি, তোমরা কবরস্থানে পৌছে যাও।"
      },
      {
        "id": 3,
        "text": "كَلَّا سَوۡفَ تَعۡلَمُونَ",
        "pronunciation": "কাল্লা সাওফা তালামূনা",
        "translation": "এটা কখনও উচিত নয়। তোমরা সত্ত্বরই জেনে নেবে।"
      },
      {
        "id": 4,
        "text": "ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ",
        "pronunciation": "ছুম্মা কাল্লা সাওফা তালামূনা",
        "translation": "অতঃপর এটা কখনও উচিত নয়। তোমরা সত্ত্বরই জেনে নেবে।"
      },
      {
        "id": 5,
        "text": "كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ",
        "pronunciation": "কাল্লা লাও তালামূনা আিলমা আল-ইয়াক্বীনি",
        "translation": "কখনই নয়; যদি তোমরা নিশ্চিত জানতে।"
      },
      {
        "id": 6,
        "text": "لَتَرَوُنَّ ٱلۡجَحِيمَ",
        "pronunciation": "লাতারাওুন্না আল-জাহীমা",
        "translation": "তোমরা অবশ্যই জাহান্নাম দেখবে"
      },
      {
        "id": 7,
        "text": "ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ",
        "pronunciation": "ছুম্মা লাতারাওুন্নাহা আইয়না আল-ইয়াক্বীনি",
        "translation": "অতঃপর তোমরা তা অবশ্যই দেখবে দিব্য প্রত্যয়ে"
      },
      {
        "id": 8,
        "text": "ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ",
        "pronunciation": "ছুম্মা লাতুসালুন্না ইয়াওমািছিন আনি আন-নাীমি",
        "translation": "এরপর অবশ্যই সেদিন তোমরা নেয়ামত সম্পর্কে জিজ্ঞাসিত হবে।"
      }
    ]
  },
  {
    "id": 103,
    "name": "العصر",
    "transliteration": "Al-'Asr",
    "translation": "সময়",
    "type": "meccan",
    "total_verses": 3,
    "verses": [
      {
        "id": 1,
        "text": "وَٱلۡعَصۡرِ",
        "pronunciation": "ওয়া-আল-আসরি",
        "translation": "কসম যুগের (সময়ের)"
      },
      {
        "id": 2,
        "text": "إِنَّ ٱلۡإِنسَٰنَ لَفِي خُسۡرٍ",
        "pronunciation": "ইন্না আল-ইনসানা লাফী খুসরিন",
        "translation": "নিশ্চয় মানুষ ক্ষতিগ্রস্ত"
      },
      {
        "id": 3,
        "text": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ وَتَوَاصَوۡاْ بِٱلۡحَقِّ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ",
        "pronunciation": "ইল্লা আল্লাযীনা আমানূ ওয়া-আমিলূ আস-সালিহাতি ওয়া-তাওাসাও বি-আল-হাক্বক্বি ওয়া-তাওাসাও বি-আস-সাবরি",
        "translation": "কিন্তু তারা নয়, যারা বিশ্বাস স্থাপন করে ও সৎকর্ম করে এবং পরস্পরকে তাকীদ করে সত্যের এবং তাকীদ করে সবরের।"
      }
    ]
  },
  {
    "id": 104,
    "name": "الهمزة",
    "transliteration": "Al-Humazah",
    "translation": "পরনিন্দাকারী",
    "type": "meccan",
    "total_verses": 9,
    "verses": [
      {
        "id": 1,
        "text": "وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ",
        "pronunciation": "ওয়া-ইয়লুন লি-কুল্লি হুমাযাতিন লুমাযাতিন",
        "translation": "প্রত্যেক পশ্চাতে ও সম্মুখে পরনিন্দাকারীর দুর্ভোগ"
      },
      {
        "id": 2,
        "text": "ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ",
        "pronunciation": "আল্লাযী জামা মালান ওয়া-আদ্দাদাহু",
        "translation": "যে অর্থ সঞ্চিত করে ও গণনা করে"
      },
      {
        "id": 3,
        "text": "يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ",
        "pronunciation": "ইয়াহসাবু আন্না মালাহু আখলাদাহু",
        "translation": "সে মনে করে যে, তার অর্থ চিরকাল তার সাথে থাকবে"
      },
      {
        "id": 4,
        "text": "كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ",
        "pronunciation": "কাল্লা লাইয়ুনবাছান্না ফী আল-হুতামাতি",
        "translation": "কখনও না, সে অবশ্যই নিক্ষিপ্ত হবে পিষ্টকারীর মধ্যে।"
      },
      {
        "id": 5,
        "text": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ",
        "pronunciation": "ওয়া-মা আদরাকা মা আল-হুতামাতু",
        "translation": "আপনি কি জানেন, পিষ্টকারী কি"
      },
      {
        "id": 6,
        "text": "نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ",
        "pronunciation": "নারু আল্লাহি আল-মূক্বাদাতু",
        "translation": "এটা আল্লাহর প্রজ্জ্বলিত অগ্নি"
      },
      {
        "id": 7,
        "text": "ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ",
        "pronunciation": "আল-লাতী তাত্তালিাু আলা আল-আফিদাতি",
        "translation": "যা হৃদয় পর্যন্ত পৌছবে।"
      },
      {
        "id": 8,
        "text": "إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ",
        "pronunciation": "লন্নাহা আলাইয়হিম মুসাদাতুন",
        "translation": "এতে তাদেরকে বেঁধে দেয়া হবে"
      },
      {
        "id": 9,
        "text": "فِي عَمَدٖ مُّمَدَّدَةِۭ",
        "pronunciation": "ফী আমাদিন মুমাদ্দাদাতিন",
        "translation": "লম্বা লম্বা খুঁটিতে।"
      }
    ]
  },
  {
    "id": 105,
    "name": "الفيل",
    "transliteration": "Al-Fil",
    "translation": "হাতি",
    "type": "meccan",
    "total_verses": 5,
    "verses": [
      {
        "id": 1,
        "text": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ",
        "pronunciation": "আল-আম তারা কাইয়ফা ফা-আলা রাব্বুকা বি-আশাবি আল-ফীলি",
        "translation": "আপনি কি দেখেননি আপনার পালনকর্তা হস্তীবাহিনীর সাথে কিরূপ ব্যবহার করেছেন"
      },
      {
        "id": 2,
        "text": "أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلٖ",
        "pronunciation": "আল-আম ইয়াজাল কাইয়দাহুম ফী তাদলীলিন",
        "translation": "তিনি কি তাদের চক্রান্ত নস্যাৎ করে দেননি"
      },
      {
        "id": 3,
        "text": "وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ",
        "pronunciation": "ওয়া-আরসালা আলাইয়হিম তাইয়রান আবাবীলা",
        "translation": "তিনি তাদের উপর প্রেরণ করেছেন ঝাঁকে ঝাঁকে পাখী"
      },
      {
        "id": 4,
        "text": "تَرۡمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ",
        "pronunciation": "তারমীহিম বি-হিজারাতিন মিন সিজ্জীলিন",
        "translation": "যারা তাদের উপর পাথরের কংকর নিক্ষেপ করছিল।"
      },
      {
        "id": 5,
        "text": "فَجَعَلَهُمۡ كَعَصۡفٖ مَّأۡكُولِۭ",
        "pronunciation": "ফা-জালাহুম কাসফিন মাকূলিন",
        "translation": "অতঃপর তিনি তাদেরকে ভক্ষিত তৃণসদৃশ করে দেন।"
      }
    ]
  },
  {
    "id": 106,
    "name": "قريش",
    "transliteration": "Quraysh",
    "translation": "কুরাইশ গোত্র",
    "type": "meccan",
    "total_verses": 4,
    "verses": [
      {
        "id": 1,
        "text": "لِإِيلَٰفِ قُرَيۡشٍ",
        "pronunciation": "লি-ঈলাফি ক্বুরাইয়শিন",
        "translation": "কোরাইশের আসক্তির কারণে"
      },
      {
        "id": 2,
        "text": "إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ",
        "pronunciation": "ঈলাফিহিম রিহলাতা আশ-শশিতাি ওয়া-আস-সাইয়ফি",
        "translation": "আসক্তির কারণে তাদের শীত ও গ্রীষ্মকালীন সফরের।"
      },
      {
        "id": 3,
        "text": "فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ",
        "pronunciation": "ফা-লইয়াবুদূ রাব্বা হাযা আল-বাইয়তি",
        "translation": "অতএব তারা যেন এবাদত করে এই ঘরের পালনকর্তার"
      },
      {
        "id": 4,
        "text": "ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ",
        "pronunciation": "আল্লাযী আতামাহুম মিন জূািন ওয়া-আমানাহুম মিন খাওফিন",
        "translation": "যিনি তাদেরকে ক্ষুধায় আহার দিয়েছেন এবং যুদ্ধভীতি থেকে তাদেরকে নিরাপদ করেছেন।"
      }
    ]
  },
  {
    "id": 107,
    "name": "الماعون",
    "transliteration": "Al-Ma'un",
    "translation": "সাহায্য সহায়তা",
    "type": "meccan",
    "total_verses": 7,
    "verses": [
      {
        "id": 1,
